NODE_ENV=development

# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=5173

# Beta access. Leave blank in local development to disable the gate.
APP_ACCESS_CODE=
SESSION_SECRET=change-me-to-a-long-random-string

# OpenAI. Leave blank to run in demo mode with seeded data.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# Supabase. Leave blank to use local JSON + filesystem storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=music-video-assets

# Limits
MAX_AUDIO_MB=50
IMAGE_GENERATION_CONCURRENCY=2
AI_RATE_LIMIT_PER_MINUTE=20

# Worker
WORKER_POLL_MS=3000
WORKER_ID=
