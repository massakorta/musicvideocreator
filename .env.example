NODE_ENV=development

# Public URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=5173

# Beta access. Leave blank in local development to disable the gate.
APP_ACCESS_CODE=
SESSION_SECRET=change-me-to-a-long-random-string

# OpenAI text (visual bible, storyboard, transcription). Blank = demo bible/storyboard.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1

# fal.ai Flux stills. Blank = demo placeholder images.
FAL_KEY=

# Supabase. Leave blank to use local JSON + filesystem storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=music-video-assets

# Limits
MAX_AUDIO_MB=50
IMAGE_GENERATION_CONCURRENCY=6
AI_RATE_LIMIT_PER_MINUTE=80

# Worker
WORKER_POLL_MS=3000
WORKER_ID=
REMOTION_CONCURRENCY=2
REMOTION_BUNDLE_DIR=
